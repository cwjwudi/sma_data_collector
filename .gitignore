# Automation Studio: 临时与用户文件（避免误提交）
Temp/
Diagnosis/
*.set
*.isopen
*.brk
*.tch
*.tr

# Obsidian / 文档（本地配置与插件，不入库）
.obsidian/
_Doc/.obsidian/

.trash

# macOS（Finder 元数据，勿入库）
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# 通用
*~
~*
*.mp4

# Visual Studio Code
.vscode
.lingma

# Python (SD_SMA_ReportEditor / SD_SMA_DATA_COLLECTOR)
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
venv/
.venv/

# Node (SD_SMA_ReportEditor frontend)
node_modules/
dist/
dist-electron/

# Runtime data
_Prj/SD_SMA_ReportEditor/backend/data/
_Build/
_Runtime/
_Prj/SD_SMA_DATA_COLLECTOR_QUERY_WEB/config/.active_query_config
_Prj/SD_SMA_DATA_COLLECTOR/config/.collector_runtime_settings.json

# Environment
.env
.env.local

# Logs
*.log
log/
logs/

# Config
config/
configs/

# 压缩文件
*.zip
*.rar
*.7z
*.tar
*.gz
*.bz2
*.xz
*.iso
*.dmg
*.pkg
*.deb
*.rpm
# B&R Automation Studio 的 Package.pkg 是工程源文件，不受上面 *.pkg 规则影响
!_Prj/**/*.pkg

# 误放的 electron-builder 构建产物（正确路径为 _Prj/SD_SMA_ReportEditor/packaging/）
/_Prj/packaging/
