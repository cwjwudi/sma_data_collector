{
  "python": ".venv/Scripts/python.exe",
  "allow_current_python_fallback": true,
  "requirements": "_Launcher/requirements-unified.txt",
  "auto_install_missing": true,
  "wheelhouse": "wheelhouse",
  "proxy": {
    "enabled": false,
    "url": "http://192.168.50.122:7890",
    "no_proxy": "localhost,127.0.0.1,::1"
  },
  "required_imports": [
    { "package": "fastapi", "import": "fastapi" },
    { "package": "uvicorn", "import": "uvicorn" },
    { "package": "pydantic", "import": "pydantic" },
    { "package": "sqlalchemy", "import": "sqlalchemy" },
    { "package": "pymysql", "import": "pymysql" },
    { "package": "python-multipart", "import": "multipart" },
    { "package": "opcua", "import": "opcua" },
    { "package": "asyncua", "import": "asyncua" }
  ],
  "open_browser": false,
  "services": [
    {
      "name": "collector_web",
      "title": "SD SMA Collector",
      "cwd": "_Prj/SD_SMA_DATA_COLLECTOR",
      "app": "web_config.main:app",
      "host": "127.0.0.1",
      "port": 8091,
      "health_path": "/api/health",
      "open_url": "http://127.0.0.1:8091/dashboard",
      "env": {
        "SD_SMA_COLLECTOR_CONFIG_DIR": "config/collector",
        "SD_SMA_LOG_DIR": "logs/collector"
      }
    },
    {
      "name": "query_web",
      "title": "SD SMA Query Web",
      "cwd": "_Prj/SD_SMA_DATA_COLLECTOR_QUERY_WEB",
      "app": "app.main:app",
      "host": "127.0.0.1",
      "port": 8092,
      "health_path": "/query",
      "open_url": "http://127.0.0.1:8092/query",
      "env": {
        "SD_SMA_QUERY_WEB_CONFIG_DIR": "config/query_web"
      }
    },
    {
      "name": "db_admin",
      "title": "SD SMA DB Admin",
      "cwd": "_Prj/SD_SMA_DB_ADMIN",
      "app": "app.main:app",
      "host": "127.0.0.1",
      "port": 8093,
      "health_path": "/api/health",
      "open_url": "http://127.0.0.1:8093/admin",
      "env": {
        "SD_SMA_DB_ADMIN_CONFIG_DIR": "config/db_admin"
      }
    },
    {
      "name": "report_copy",
      "title": "SD SMA Report Copy",
      "cwd": "_Prj/SD_SMA_REPORT_COPY",
      "app": "app.main:app",
      "host": "127.0.0.1",
      "port": 8094,
      "health_path": "/api/health",
      "open_url": "http://127.0.0.1:8094/",
      "env": {
        "SD_SMA_REPORT_COPY_CONFIG_DIR": "config/report_copy"
      }
    }
  ]
}
