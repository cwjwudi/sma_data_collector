{
  "communications": [
    {
      "name": "PLC1",
      "type": "opcua",
      "host": "192.168.50.233",
      "port": 4840
    }
  ],
  "connections": [
    {
      "name": "connection1",
      "communication": "PLC1",
      "data_groups": ["sensor_group_1", "query_group_1"]
    }
  ],
  "points": [
    {
      "name": "msg",
      "path": "ns=6;s=::AlarmQuerr:msg",
      "description": "PLC1测试FLOAT数据"
    },
    {
      "name": "bTriggerQuery",
      "path": "ns=6;s=::AlarmQuerr:bExecuteRead",
      "description": "用于触发查询任务"
    },
    {
      "name": "strStartTimes",
      "path": "ns=6;s=::AlarmQuerr:stDbReadQuery.stConfig.strStartTime",
      "description": ""
    },
    {
      "name": "strEndTimes",
      "path": "ns=6;s=::AlarmQuerr:stDbReadQuery.stConfig.strEndTime",
      "description": ""
    },
    {
      "name": "strPointNames",
      "path": "ns=6;s=::AlarmQuerr:stDbReadQuery.stConfig.strPointName",
      "description": ""
    }
  ],
  "groups": [
    {
      "name": "sensor_group_1",
      "interval_seconds": 1,
      "trigger": "time",
      "description": "PLC1传感器组，每1秒采集一次",
      "data_points": ["msg"],
      "trigger_point": null,
      "recreate_interval_days": 1,
      "batch_insert_size": 5
    },
    {
      "name": "query_group_1",
      "interval_seconds": 0.5,
      "trigger": "query",
      "description": "用于处理查询任务，不要改动该字段，interval_seconds检查bTriggerQuery的轮询时间，单位是秒",
      "data_points": ["strStartTimes", "strEndTimes", "strPointNames"],
      "trigger_point": "bTriggerQuery",
      "query_config": {
        "start_time_field": "strStartTimes",
        "end_time_field": "strEndTimes",
        "query_point_field": "strPointNames",
        "output_file": null
      }
    }
  ],
  "database": {
    "type": "mysql",
    "name": "wn_10",
    "host": "192.168.50.22",
    "port": 3306,
    "username": "root",
    "password": "Br54644800@",
    "data_groups": ["sensor_group_1", "query_group_1"]
  }
}
