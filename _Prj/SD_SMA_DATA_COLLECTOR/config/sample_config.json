      "name": "bTriggerQuery",
      "path": "ns=6;s=::DataRev:bExecuteRead",
      "description": "用于触发查询任务"
    },
    {
      "name": "strStartTimes",
      "path": "ns=6;s=::DataRev:stDbReadQuery.stConfig.strStartTime",
