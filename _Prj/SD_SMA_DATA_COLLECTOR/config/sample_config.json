  "groups": [
    {
      "name": "sensor_group_1",
      "interval_seconds": 1,
      "trigger": "time",
      "description": "PLC1传感器组，每1秒采集一次",
      "data_points": ["rEC", "rF10", "rF11", "rF12", "rF13", "rF14", "rF15"],
      "trigger_point": null,
      "recreate_interval_days": 1,
      "batch_insert_size": 5
    },
    {
      "name": "sensor_group_2",
      "interval_seconds": 1,
      "trigger": "time",
      "description": "远程PLC传感器组，每1秒采集一次",
      "data_points": ["rAIR", "rAP1", "rBP1"],
      "trigger_point": null,
      "recreate_interval_days": 1,
      "batch_insert_size": 5
    },   
    {
      "name": "trigger_group_1",
      "interval_seconds": 0,
      "trigger": "variable",
      "description": "PLC2触发组，由变量触发采集",
      "data_points": ["rF1", "rF2", "rF3", "rF4"],
      "trigger_point": "bTrigger1",
      "reset_trigger_after_read": false,
      "recreate_interval_days": 15,
      "batch_insert_size": 1
    },
    {
      "name": "query_group_1",
      "interval_seconds": 0.5,
      "trigger": "query",
      "description": "用于处理查询任务，不要改动该字段，interval_seconds检查bTriggerQuery的轮询时间，单位是秒",
      "data_points": ["strStartTimes", "strEndTimes", "strPointNames"],
      "trigger_point": "bTriggerQuery",
      "query_config": {
        "start_time_field": "strStartTimes",
        "end_time_field": "strEndTimes",
        "query_point_field": "strPointNames",
        "output_file": null
      }
    }
  ],
