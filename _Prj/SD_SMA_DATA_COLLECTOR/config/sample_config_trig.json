{
  "communications": [
    {
      "name": "PLC1",
      "type": "opcua",
      "host": "127.0.0.1",
      "port": 4840
    },
    {
      "name": "Remote_PLC",
      "type": "opcua",
      "host": "192.168.50.233",
      "port": 4840
    }
  ],
  "connections": [
    {
      "name": "connection1",
      "communication": "PLC1",
      "data_groups": ["trigger_group_1"]
    },
    {
      "name": "connection3",
      "communication": "Remote_PLC",
      "data_groups": ["sensor_group_trig"]
    }
  ],
  "points": [
    {
      "name": "iTest1",
      "path": "ns=6;s=::OpcCon:iTest1",
      "description": "PLC1测试INT数据"
    },
    {
      "name": "rTemp1", 
      "path": "ns=6;s=::OpcCon:rTemp",
      "description": "PLC1测试REAL数据"
    },
    {
      "name": "rAIR",
      "path": "ns=6;s=::Demo:AIR",
      "description": "远程PLC AIR数据"
    },
    {
      "name": "rAP1",
      "path": "ns=6;s=::Demo:AP1",
      "description": "远程PLC AP1数据"
    },
    {
      "name": "rBP1",
      "path": "ns=6;s=::Demo:BP1",
      "description": "远程PLC BP1数据"
    },
    { 
      "name": "rF13",
      "path": "ns=6;s=::Demo:F13",
      "description": "远程PLC F13数据"
    },
    { 
      "name": "rEST",
      "path": "ns=6;s=::Demo:EST",
      "description": "远程PLC EST数据"
    },
    { 
      "name": "rHT1",
      "path": "ns=6;s=::Demo:HT1",
      "description": "远程PLC rHT1数据"
    },    
    {
      "name": "bTrigger1",
      "path": "ns=6;s=::OpcCon:bSwitch",
      "description": "PLC1触发点1，布尔类型"
    },
    {
      "name": "bTrigger2",
      "path": "ns=6;s=::OpcCon:bSwitch2",
      "description": "PLC1触发点2，布尔类型"
    },
    {
      "name": "bTrigger1_remote",
      "path": "ns=6;s=::OpcCon:bSwitch",
      "description": "PLC1触发点1，布尔类型"
    },
    {
      "name": "bTrigger2_remote",
      "path": "ns=6;s=::OpcCon:bSwitch2",
      "description": "PLC1触发点2，布尔类型"
    }
  ],
  "groups": [
    {
      "name": "sensor_group_1",
      "interval_seconds": 1,
      "trigger": "time",
      "description": "PLC1传感器组，每1秒采集一次",
      "data_points": ["iTest1", "rTemp1"],
      "trigger_point": null,
      "recreate_interval_days": 1,
      "batch_insert_size": 2
    },
    {
      "name": "remote_sensor_group",
      "interval_seconds": 1,
      "trigger": "time",
      "description": "远程PLC传感器组，每5秒采集一次",
      "data_points": ["rAIR", "rAP1", "rBP1"],
      "trigger_point": null,
      "recreate_interval_days": 1,
      "batch_insert_size": 4
    },
    {
      "name": "sensor_group_trig",
      "interval_seconds": 0,
      "trigger": "variable",
      "description": "由Triger信号触发",
      "data_points": ["rHT1", "rEST", "rF13"],
      "trigger_point": "bTrigger1",
      "reset_trigger_after_insert": true,
      "recreate_interval_days": 1,
      "batch_insert_size": 1
    },
    {
      "name": "trigger_group_1",
      "interval_seconds": 0.1,
      "trigger": "time",
      "description": "PLC2 触发组",
      "data_points": ["bTrigger1", "bTrigger2"],
      "is_trigger_group": true
    },
    {
      "name": "trigger_group_2",
      "interval_seconds": 0.1,
      "trigger": "time",
      "description": "远程 PLC 触发组",
      "data_points": ["bTrigger1_remote", "bTrigger2_remote"],
      "is_trigger_group": true
    }
  ],
  "database": {
    "type": "mysql",
    "name": "wn_10",
    "host": "127.0.0.1",
    "port": 3306,
    "username": "newuser",
    "password": "123456",
    "data_groups": ["sensor_group_trig"]
  }
}
