{
  "name": "sd-sma-report-editor-ai",
  "version": "0.3.152",
  "description": "Report Editor AI — 报表编辑器 AI 版（Electron + FastAPI）",
  "author": "B&R Team",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <24"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "api:dev": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File ../backend/scripts/dev_uvicorn.ps1",
    "api:dev:unix": "bash ../backend/scripts/dev_uvicorn.sh",
    "opcua:demo": "cd ../backend && ./venv/bin/python3 scripts/demo_opcua_server.py",
    "fonts:fetch": "node ../packaging/scripts/fetch-bundled-fonts.mjs",
    "prebuild": "npm run fonts:fetch",
    "build": "vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "electron:dev": "concurrently -k -s command-electron -n vite,electron \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:dev:unix": "concurrently -k -s command-electron -n vite,electron \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:open": "electron .",
    "electron:build": "vite build && electron .",
    "build:backend": "powershell -ExecutionPolicy Bypass -File ../backend/scripts/build-backend-exe.ps1",
    "build:backend:mac": "bash ../backend/scripts/build-backend-exe.sh",
    "migrate:legacy-release": "bash scripts/migrate-legacy-release.sh",
    "migrate:legacy-release:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/migrate-legacy-release.ps1",
    "clean:legacy-release": "bash scripts/clean-legacy-release.sh",
    "clean:legacy-release:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-legacy-release.ps1",
    "clean:release:mac": "bash scripts/clean-release.sh ../packaging/mac/output",
    "clean:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-release.ps1 ..\\packaging\\windows\\output",
    "clean:release:alt": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-release.ps1 ..\\packaging\\windows\\output-alt",
    "clean:eb-cache": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-electron-builder-cache.ps1",
    "dist": "npm run build && electron-builder --win --config.directories.output=../packaging/windows/output",
    "dist:alt": "npm run build && electron-builder --win --config.directories.output=../packaging/windows/output-alt",
    "dist:cn": "set ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/&& npm run dist",
    "dist:cn:alt": "set ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/&& npm run build && electron-builder --win --config.directories.output=../packaging/windows/output-alt",
    "dist:cn:portable": "set ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/&& npm run build && electron-builder --win portable --config.directories.output=../packaging/windows/output-alt",
    "dist:cn:fresh": "npm run clean:release && set ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/&& npm run dist",
    "dist:win": "npm run build:backend && npm run dist",
    "dist:win:cn": "set ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/&& npm run dist:win",
    "dist:win:cn:alt": "npm run build:backend && set ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/&& npm run build && electron-builder --win --config.directories.output=../packaging/windows/output-alt",
    "dist:win:cn:fresh": "npm run clean:release && set ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/&& npm run dist:win",
    "dist:win:cn:installer": "npm run build:backend && set ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/&& npm run build && electron-builder --win nsis --config.directories.output=../packaging/windows/output",
    "dist:mac": "npm run build && electron-builder --mac dmg --config.directories.output=../packaging/mac/output",
    "dist:mac:dmg": "npm run build && electron-builder --mac dmg --config.directories.output=../packaging/mac/output",
    "dist:mac:installer": "npm run build:backend:mac && npm run build && electron-builder --mac dmg --config.directories.output=../packaging/mac/output",
    "generate:update-manifest": "node ../packaging/scripts/generate-update-manifest.mjs",
    "publish:portal": "node ../packaging/scripts/publish-portal-release.mjs --copy-artifacts",
    "bump:version": "node ../packaging/scripts/bump-version.mjs"
  },
  "build": {
    "appId": "com.brteam.sd_sma.report_editor_ai",
    "productName": "Report Editor AI",
    "copyright": "Copyright © B&R Team",
    "publish": [
      {
        "provider": "generic",
        "url": "https://brportal.cpolar.top/downloads/report-editor"
      }
    ],
    "icon": "build/icon.png",
    "afterPack": "scripts/electron-after-pack.cjs",
    "extraMetadata": {
      "main": "electron/main.cjs",
      "type": "commonjs"
    },
    "directories": {
      "output": "../packaging/windows/output",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*.cjs",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "../backend/dist/report_backend",
        "to": "report_backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../packaging/updates/latest.json",
        "to": "update-notes/latest.json"
      },
      {
        "from": "dist",
        "to": "web",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/fonts",
        "to": "fonts",
        "filter": [
          "**/*.otf",
          "**/*.ttf",
          "README.md"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "signDlls": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "报表编辑器 AI 版",
      "uninstallDisplayName": "报表编辑器 AI 版",
      "guid": "79bdc331-4353-5562-ae4a-943f23cb6b27",
      "menuCategory": "B&R Team",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false,
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.exe"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "darkModeSupport": true
    },
    "dmg": {
      "title": "${productName} ${version}",
      "artifactName": "${productName}-${version}-${arch}.dmg"
    }
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@vueuse/core": "^12.0.0",
    "echarts": "^6.0.0",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pinia": "^2.3.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.11",
    "concurrently": "^9.2.1",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "happy-dom": "^20.10.6",
    "rcedit": "^4.0.1",
    "typescript": "^6.0.3",
    "vite": "^6.2.0",
    "vitest": "^4.1.6",
    "wait-on": "^8.0.5"
  }
}
