{
  "name": "sd-sma-report-editor",
  "version": "0.1.0",
  "description": "SD SMA Report Editor — Markdown 报表编辑器（Electron + FastAPI）",
  "author": "B&R Team",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron .",
    "build:backend": "powershell -ExecutionPolicy Bypass -File ../backend/scripts/build-backend-exe.ps1",
    "clean:release": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"if (Test-Path 'release/win-unpacked') { Remove-Item -LiteralPath 'release/win-unpacked' -Recurse -Force }\"",
    "dist": "npm run build && electron-builder --win",
    "dist:cn": "set ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/&& npm run dist",
    "dist:cn:fresh": "npm run clean:release && set ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/&& npm run dist",
    "dist:win": "npm run build:backend && npm run dist",
    "dist:win:cn": "set ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/&& npm run dist:win",
    "dist:win:cn:fresh": "npm run clean:release && set ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/&& npm run dist:win"
  },
  "build": {
    "appId": "com.brteam.sd_sma.report_editor",
    "productName": "SD SMA Report Editor",
    "copyright": "Copyright © B&R Team",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/main.js",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "../backend/dist/report_backend",
        "to": "report_backend",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "signDlls": false,
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.exe"
    }
  },
  "dependencies": {
    "@vueuse/core": "^12.0.0",
    "markdown-it": "^14.0.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "concurrently": "^9.2.1",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.2.0",
    "wait-on": "^8.0.5"
  }
}
