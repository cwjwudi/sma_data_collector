{
  "name": "sd-sma-report-editor",
  "version": "0.1.0",
  "description": "SD SMA Report Editor — Markdown 报表编辑器（Electron + FastAPI）",
  "author": "B&R Team",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "api:dev": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File ../backend/scripts/dev_uvicorn.ps1",
    "api:dev:unix": "bash ../backend/scripts/dev_uvicorn.sh",
    "opcua:demo": "cd ../backend && ./venv/bin/python3 scripts/demo_opcua_server.py",
    "build": "vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "electron:dev": "concurrently -k -s command-electron -n vite,electron \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:dev:unix": "concurrently -k -s command-electron -n vite,electron \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:open": "electron .",
    "electron:build": "vite build && electron .",
    "build:backend": "powershell -ExecutionPolicy Bypass -File ../backend/scripts/build-backend-exe.ps1",
    "build:backend:mac": "bash ../backend/scripts/build-backend-exe.sh",
    "clean:release:mac": "bash scripts/clean-release.sh ../../packaging/mac/output",
    "clean:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-release.ps1",
    "clean:release:alt": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-release.ps1 release-alt",
    "clean:eb-cache": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-electron-builder-cache.ps1",
    "dist": "npm run build && electron-builder --win",
    "dist:alt": "npm run build && electron-builder --win --config.directories.output=release-alt",
    "dist:cn": "set ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/&& npm run dist",
    "dist:cn:alt": "set ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/&& npm run build && electron-builder --win --config.directories.output=release-alt",
    "dist:cn:portable": "set ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/&& npm run build && electron-builder --win portable --config.directories.output=release-alt",
    "dist:cn:fresh": "npm run clean:release && set ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/&& npm run dist",
    "dist:win": "npm run build:backend && npm run dist",
    "dist:win:cn": "set ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/&& npm run dist:win",
    "dist:win:cn:alt": "npm run build:backend && set ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/&& npm run build && electron-builder --win --config.directories.output=release-alt",
    "dist:win:cn:fresh": "npm run clean:release && set ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/&& npm run dist:win",
    "dist:win:cn:installer": "npm run build:backend && set ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/&& npm run build && electron-builder --win nsis --config.directories.output=../../packaging/windows/output",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:mac:dmg": "npm run build && electron-builder --mac dmg --config.directories.output=../../packaging/mac/output",
    "dist:mac:installer": "npm run build:backend:mac && npm run build && electron-builder --mac dmg --config.directories.output=../../packaging/mac/output"
  },
  "build": {
    "appId": "com.brteam.sd_sma.report_editor",
    "productName": "SD SMA Report Editor",
    "copyright": "Copyright © B&R Team",
    "extraMetadata": {
      "main": "electron/main.cjs",
      "type": "commonjs"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "../backend/dist/report_backend",
        "to": "report_backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "signDlls": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SD SMA 报表编辑器",
      "uninstallDisplayName": "SD SMA 报表编辑器",
      "menuCategory": "B&R Team",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": true,
      "displayLanguageSelector": false,
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "include": "build/installer.nsh",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.exe"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "darkModeSupport": true
    },
    "dmg": {
      "title": "${productName} ${version}",
      "artifactName": "${productName}-${version}-${arch}.dmg"
    }
  },
  "dependencies": {
    "@vueuse/core": "^12.0.0",
    "echarts": "^6.0.0",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.0.0",
    "pdfjs-dist": "^4.10.38",
    "pinia": "^2.3.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "concurrently": "^9.2.1",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^6.0.3",
    "vite": "^6.2.0",
    "vitest": "^4.1.6",
    "wait-on": "^8.0.5"
  }
}
