VAR
	Client : httpClient := (enable:=FALSE,send:=FALSE,abort:=FALSE,option:=0,pHost:=0,hostPort:=0,method:=httpMETHOD_GET,pUri:=0,pRequestHeader:=0,pRequestData:=0,requestDataLen:=0,pResponseHeader:=0,pResponseData:=0,responseDataSize:=0,pStatistics:=0,pStruct:=0,status:=0,tcpStatus:=0,httpStatus:=0,responseDataLen:=0,phase:=0,_i_state:=0,_i_result:=0,_ident:=0,_oldEnable:=0,_oldAbort:=0,_oldSend:=0,_state:=0,_internal:=0); (*httpClient instance*)
	Doenable : BOOL := FALSE; (*Enables FUB Instance*)
	Dosend : BOOL := FALSE; (*Sends request on positive edge*)
	Host : STRING[100] := 'localhost'; (*Server to connect to*)
	Responsedata : STRING[80] := ''; (*buffer for response data*)
	Ressource : STRING[80] := ''; (*file or webservice to be requested*)
END_VAR
