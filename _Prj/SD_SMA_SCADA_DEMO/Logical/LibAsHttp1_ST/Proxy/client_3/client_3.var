 ********************************************************************
 * Local variables of program Client_2
 ********************************************************************)
VAR
	mylen : UDINT := 0;
	_Connectioninformation : STRING[80] := '';
	Client : httpClient; (*httpClient instance*)
	Doenable : BOOL := FALSE; (*Enables FUB Instance*)
	Dosend : BOOL := FALSE; (*Sends request on positive edge*)
	Host : STRING[100] := 'localhost:80'; (*Webserver and Port  to connect to*)
	Proxy : STRING[100] := '127.0.0.1'; (*Proxy to connect to*)
	Proxyport : UINT := 8888; (*Port of proxy*)
	Requestheader : httpRequestHeader_t := (0);
	Responsedata : STRING[300]; (*buffer for response data*)
	Ressource : STRING[80] := ''; (*file or webservice to be requested*)
END_VAR
