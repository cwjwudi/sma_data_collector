(*Global DataSQL Constant*)
VAR CONSTANT
	REV_BUFFER_SIZE : UINT := 2000;
	REV_BUFFER_SIZE_MINUS : UINT := REV_BUFFER_SIZE-1;
	READ_QUERY_SIZE : UINT := 30;
	READ_QUERY_SIZE_MINUS : UINT := READ_QUERY_SIZE-1;
	READ_QUERY_SIZE_RCP : UINT := 27;
	READ_QUERY_SIZE_RCP_MINUS : UINT := READ_QUERY_SIZE_RCP-1;
	READ_QUERY_SIZE_PRO : UINT := 8;
	READ_QUERY_SIZE_PRO_MINUS : UINT := READ_QUERY_SIZE_PRO-1;
	READ_QUERY_SIZE_ALARM : UINT := 4;
	READ_QUERY_SIZE_ALARM_MINUS : UINT := READ_QUERY_SIZE_ALARM-1;
	READ_QUERY_SIZE_AUDIT : UINT := 3;
	READ_QUERY_SIZE_AUDIT_MINUS : UINT := READ_QUERY_SIZE_AUDIT-1;
END_VAR
(*Global DataSQL Constant*)
VAR CONSTANT
	DATA_ALARM_NUM : USINT := 100;
	DATA_ALARM_NUM_MINUS : USINT := DATA_ALARM_NUM-1;
	DATA_AUDIT_NUM : USINT := 100;
	DATA_AUDIT_NUM_MINUS : USINT := DATA_AUDIT_NUM-1;
	QUERY_TIME_OFFSET : DATE_AND_TIME := DT#1970-01-01-00:05:00;
END_VAR
(*Global DataSQL Variable*)
VAR
	gDataSQLHeartBeat : UINT;
	gDataSQLCommFault : BOOL;
	gDataSQLOperate : DataSQLOperate_typ;
	gDataSQLProduct : DataProduct_typ;
END_VAR
